{
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "${workspaceFolder}/app/data"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.8.31"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${workspaceFolder}/.mcp-memory/memory.json"
      }
    }
  }
}

