{
  "name": "udc-ws06-mcp-server",
  "version": "1.0.0",
  "description": "Read-only MCP server (stdio) over the seeded catalog domain in ../app — UDC Workshop 6, Task B",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
