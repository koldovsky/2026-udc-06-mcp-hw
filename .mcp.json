{
  "mcpServers": {
    "filesystem": {
      "command": "node",
      "args": [
        "./scripts/fs-proxy.mjs",
        "--allow",
        "./app/data/catalog.json",
        "--",
        "./node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "./app/data"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.7.4"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${MCP_MEMORY_FILE}"
      }
    },
    "catalog": {
      "command": "node",
      "args": [
        "./mcp-server/dist/server.js"
      ]
    }
  }
}
