{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "./app/data"
      ]
    },
    "catalog": {
      "command": "node",
      "args": ["./mcp-server/dist/server.js"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory@2026.8.31"],
      "env": {
        "MEMORY_FILE_PATH": "${MEMORY_FILE_PATH:-/tmp/ws06-mcp-memory.jsonl}"
      }
    }
  }
}
