{
  "mcpServers": {
    "catalog-filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "${MCP_PROJECT_DIR}/app/data"
      ]
    },
    "project-memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory@2026.7.4"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${MCP_PROJECT_DIR}/.mcp-memory.jsonl"
      }
    },
    "catalog-server": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${MCP_PROJECT_DIR}/mcp-server/dist/server.js"
      ]
    }
  }
}
